#!/usr/bin/env bash
# yadm bootstrap: set up a fresh macOS, Ubuntu or WSL machine. Safe to re-run.
set -euo pipefail

PACKAGES="$HOME/.config/yadm/packages"
GPG_KEY=5BD5A9CDE82D0B96
OS="$(uname -s)"
IS_WSL=false
grep -qi microsoft /proc/version 2>/dev/null && IS_WSL=true

step() { printf '\n==> %s\n' "$*"; }

# Read a package list, ignoring comments and blank lines
read_list() { grep -v -e '^#' -e '^[[:space:]]*$' "$1"; }

load_brew() {
  for prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
    if [ -x "$prefix/bin/brew" ]; then
      eval "$("$prefix/bin/brew" shellenv)"
      return 0
    fi
  done
  return 1
}

install_brew() {
  if ! load_brew; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    load_brew
  fi
}

# Add a vendor apt repository unless one for the same URL is already configured
add_apt_repo() {
  local name="$1" key_url="$2" repo_line="$3" repo_url="$4"
  if grep -qs "$repo_url" /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; then
    return 0
  fi
  curl -fsSL "$key_url" | sudo gpg --dearmor --yes -o "/usr/share/keyrings/$name.gpg"
  echo "deb [signed-by=/usr/share/keyrings/$name.gpg] $repo_line" | sudo tee "/etc/apt/sources.list.d/$name.list" >/dev/null
}

# Install the packages of a list that exist in this Ubuntu release, skip the rest
apt_install_list() {
  local pkg available=()
  while read -r pkg; do
    if apt-cache show "$pkg" >/dev/null 2>&1; then
      available+=("$pkg")
    else
      echo "Skipping $pkg: not available in this Ubuntu release"
    fi
  done < <(read_list "$1")
  sudo apt-get install -y "${available[@]}"
}

# Install a vendor .deb once; its postinst adds the vendor's apt repo for updates
install_deb() {
  local pkg="$1" url="$2" deb
  dpkg -s "$pkg" >/dev/null 2>&1 && return 0
  deb="$(mktemp --suffix=.deb)"
  curl -fsSL -o "$deb" "$url"
  sudo apt-get install -y "$deb"
  rm -f "$deb"
}

install_packages_ubuntu() {
  step "Installing apt packages"
  sudo apt-get update
  sudo apt-get install -y curl gnupg
  add_apt_repo google-cloud \
    https://packages.cloud.google.com/apt/doc/apt-key.gpg \
    "https://packages.cloud.google.com/apt cloud-sdk main" \
    packages.cloud.google.com/apt
  sudo apt-get update
  apt_install_list "$PACKAGES/apt.txt"
  sudo apt-get install -y google-cloud-cli google-cloud-cli-gke-gcloud-auth-plugin

  # Docker on Linux/WSL (podman on macOS). Skip if Docker CE or Docker Desktop already provides it.
  if ! command -v docker >/dev/null 2>&1; then
    step "Installing Docker"
    sudo apt-get install -y docker.io docker-compose-v2 docker-buildx
  fi
  if ! id -nG | grep -qw docker; then
    sudo usermod -aG docker "$USER"
    echo "Added $USER to the docker group - log out and back in to use docker without sudo."
  fi

  if [ "$IS_WSL" = false ]; then
    step "Installing desktop apps"
    apt_install_list "$PACKAGES/apt-desktop.txt"
    install_deb google-chrome-stable https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    install_deb code "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"
    read_list "$PACKAGES/snap.txt" | while read -r snap; do
      sudo snap install "$snap" </dev/null || echo "Failed to install snap $snap"
    done
  fi

  step "Installing Homebrew packages apt does not provide"
  install_brew
  brew bundle install --file="$PACKAGES/Brewfile.linux" || echo "Some Homebrew packages failed, see above."

  if [ ! -s "$HOME/.nvm/nvm.sh" ]; then
    step "Installing nvm"
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | PROFILE=/dev/null bash
  fi
}

install_packages_macos() {
  step "Installing Homebrew packages"
  install_brew
  brew bundle install --file="$HOME/.Brewfile" || echo "Some Homebrew packages failed, see above."
}

setup_oh_my_zsh() {
  if [ -d "$HOME/.oh-my-zsh" ]; then
    step "Updating oh-my-zsh"
    ZSH="$HOME/.oh-my-zsh" zsh "$HOME/.oh-my-zsh/tools/upgrade.sh" || true
  else
    step "Installing oh-my-zsh"
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
      sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
  fi
}

set_default_shell() {
  local zsh_path
  zsh_path="$(command -v zsh)"
  if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
    step "Making zsh the default shell"
    chsh -s "$zsh_path"
  fi
}

import_gpg_key() {
  local answer=""
  if gpg --list-secret-keys "$GPG_KEY" >/dev/null 2>&1; then
    echo "Already imported."
    return 0
  fi
  read -r -p "Decrypt and import the personal GPG signing key? [y/N] " answer || true
  if [ "$answer" = "y" ] || [ "$answer" = "Y" ]; then
    # Only extract the GPG export; older archives also contain SSH keys
    gpg -d "$HOME/.local/share/yadm/archive" | tar -x -C "$HOME" --wildcards '.gnupg/.exported-keyring/*'
    gpg --import "$HOME/.gnupg/.exported-keyring"/*.asc
    gpg --import-ownertrust "$HOME/.gnupg/.exported-keyring/ownertrust.txt"
  elif ! grep -qs 'gpgSign = false' "$HOME/.gitconfig.local"; then
    # Without the key every commit would fail, so turn signing off on this machine
    printf '[commit]\n\tgpgSign = false\n' >>"$HOME/.gitconfig.local"
    echo "Commit signing disabled in ~/.gitconfig.local"
  fi
}

step "Creating dev folders"
mkdir -p "$HOME/dev/mediamarktsaturn" "$HOME/dev/darikletter"

case "$OS" in
  Darwin) install_packages_macos ;;
  Linux) install_packages_ubuntu ;;
  *) echo "Unsupported OS: $OS" && exit 1 ;;
esac

setup_oh_my_zsh
set_default_shell

if [ ! -e "$HOME/.ssh/id_ed25519" ]; then
  step "Generating SSH key"
  "$HOME/.config/.scripts/generate-ssh-key.sh"
fi

step "GPG signing key"
import_gpg_key

if [ "$OS" = "Darwin" ]; then
  step "Applying macOS settings"
  "$HOME/.config/.scripts/osx_settings.sh"
fi

step "Done"
if yadm remote get-url origin | grep -q '^https://'; then
  echo "Once your SSH key is added on GitHub, switch the dotfiles remote to SSH:"
  echo "  yadm remote set-url origin git@github.com:daribock/dotfiles.git"
fi
echo "Open a new terminal to start zsh."
